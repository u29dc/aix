{
	"name": "aix",
	"version": "1.0.0",
	"type": "module",
	"private": true,
	"scripts": {
		"init---------------------------------": "",
		"prepare": "husky",
		"dev----------------------------------": "",
		"predev": "rm -rf dist && mkdir -p dist && cp manifest.json dist/ && cp -R assets dist/",
		"dev": "NODE_ENV=development rolldown -c --watch",
		"prebuild": "rm -rf dist",
		"build": "NODE_ENV=production rolldown -c",
		"postbuild": "cp manifest.json dist/ && cp -R assets dist/",
		"check--------------------------------": "",
		"util:format": "oxfmt --write .",
		"util:format:check": "oxfmt --check .",
		"util:lint": "oxlint . --type-aware --deny-warnings",
		"util:lint:fix": "oxlint . --type-aware --fix --deny-warnings",
		"util:types": "tsgo --noEmit",
		"util:check": "STATUS=0; bun run util:format || STATUS=1; bun run util:lint || STATUS=1; bun run util:types || STATUS=1; bun test --concurrent || STATUS=1; bun run build || STATUS=1; exit $STATUS"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@happy-dom/global-registrator": "^20.10.6",
		"@typescript/native-preview": "^7.0.0-dev.20260707.2",
		"bun-types": "^1.3.14",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.8",
		"oxfmt": "^0.58.0",
		"oxlint": "^1.73.0",
		"oxlint-tsgolint": "^0.24.0",
		"rolldown": "^1.1.5",
		"typescript": "^7.0.2"
	}
}
